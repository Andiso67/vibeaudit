# Configuración de producción para AWS EC2 (docker-compose.prod.yml).
# Copiar a .env en el servidor y rellenar.

# ── Postgres ─────────────────────────────────────────────────────────────
# ¡Obligatorio cambiarla! Contraseña del usuario de la BD.
POSTGRES_USER=vibeaudit
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=vibeaudit

# ── URL pública de la API (DuckDNS) ──────────────────────────────────────
# La consola (dashboard) corre en el navegador del cliente y llama a la API
# desde ahí. Apunta al hostname DuckDNS + puerto de la API, p. ej.:
#   NEXT_PUBLIC_API_URL=http://miApp.duckdns.org:8000
# Requisito: el router/SG de EC2 debe abrir ese puerto y DuckDNS debe apuntar
# a la IP elástica/EIP de la instancia.
NEXT_PUBLIC_API_URL=http://miApp.duckdns.org:8000

# ── URL de conexión a Postgres para la API ───────────────────────────────
# Si se omite, docker-compose.prod.yml la construye a partir de POSTGRES_*.
# OBLIGATORIA si POSTGRES_PASSWORD contiene caracteres especiales
# (@ : / & ...): la API la usa tal cual, así que la contraseña debe ir
# percent-encoded (p. ej. "p@ss" -> "p%40ss").
#   VIBEAUDIT_DATABASE_URL=postgresql://vibeaudit:cambia-esta-contrasena@postgres:5432/vibeaudit

# ── CORS ─────────────────────────────────────────────────────────────────
# Orígenes desde los que el navegador puede llamar a la API (el dominio
# DuckDNS del dashboard). Separados por comas.
VIBEAUDIT_CORS_ORIGINS=http://miApp.duckdns.org:3000

# ── Puertos publicados (defaults; solo cambia si hay conflicto) ─────────
# API_PORT=8000
# DASHBOARD_PORT=3000

# ── Credenciales opcionales de nube (scanner --cloud) ───────────────────
VERCEL_TOKEN=
SUPABASE_ACCESS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
